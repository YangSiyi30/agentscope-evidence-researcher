# Only --live uses these. Never commit a real .env file.
# Use an OpenAI-compatible chat endpoint supporting function calling.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
MODEL_API_KEY=replace-with-your-model-key
# Optional; leave empty to use DuckDuckGo without a search key.
TAVILY_API_KEY=
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL aliases are also supported.
# Without a Tavily key, --search-provider auto selects DuckDuckGo.
# --reader browser uses an isolated headless Edge browser by default.
# Local alternatives (must use the exact loaded model name):
# MODEL_BASE_URL=http://localhost:11434/v1   # Ollama compatible endpoint
# MODEL_BASE_URL=http://localhost:1234/v1    # LM Studio compatible endpoint
# MODEL_API_KEY=local-placeholder
